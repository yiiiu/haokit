# 号工具（HaoKit）运行配置示例
# 生产环境：复制到 /etc/haokit.env 后修改，由 systemd 读取（见 deploy/haokit.service）
# 本地开发不需要这个文件，全部有默认值

# 监听地址和端口。生产环境保持 127.0.0.1，由反向代理（Caddy 或 1Panel 的 OpenResty）对外提供 HTTPS
# 线上建议把 PORT 换成 10000–32000 之间没被占用的随机端口，反向代理的地址要同步改
HOST=127.0.0.1
PORT=3000

# 网站正式地址（不带末尾斜杠），用于 canonical 链接和 sitemap.xml
SITE_URL=https://haokit.run

# 信任哪些反向代理转发的真实 IP 和协议。Caddy 和本服务在同一台机器时用 loopback
TRUST_PROXY=loopback

# 套了 Cloudflare 时取消注释：用 Cloudflare 转发的头识别访问者真实 IP
# 同时务必让服务器只接受 Cloudflare 的回源请求（见 deploy/README.md），否则这个头可以被伪造
# CLIENT_IP_HEADER=cf-connecting-ip

# 取件接口限流：每个 IP 每 RATE_LIMIT_WINDOW_SEC 秒最多 RATE_LIMIT_MAX 次（设为 0 关闭）
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SEC=600

# 取件并发：全站同时最多 MAX_CONCURRENT_FETCH 个，单个 IP 最多 MAX_CONCURRENT_PER_IP 个，
# 超出的排队，最多等 FETCH_QUEUE_TIMEOUT_SEC 秒
MAX_CONCURRENT_FETCH=20
MAX_CONCURRENT_PER_IP=5
FETCH_QUEUE_TIMEOUT_SEC=30

# 访问统计：Cloudflare Web Analytics 的站点令牌（免费、不用 Cookie）。不填就不统计
# 获取方法见 deploy/README.md 的「访问统计」一节
# CF_ANALYTICS_TOKEN=

# 微软登录租户和 IMAP 服务器，一般不用改
# MS_TENANT=common
# OUTLOOK_IMAP_HOST=outlook.office365.com
